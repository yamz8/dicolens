#!/bin/bash
set -euo pipefail

# Records the GIFs docs/features.md shows into docs/demos from made-up scans, offscreen.
# Name scenes (open, slices, window, …) to record only those.
root="$(cd "$(dirname "$0")/.." && pwd)"
"$root/bin/build"
cmake --build "$root/build" --target dicolens_demo -j"$(nproc)"
cd "$root"
QT_QPA_PLATFORM=offscreen build/dicolens_demo docs/demos "$@"
